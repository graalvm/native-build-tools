{
  "defaults": {
    "agent_timeout": "2h"
  },
  "agents": {
    "codex": {
      "command": [
        "codex",
        "exec"
      ],
      "model_flag": "--model",
      "stdin_prompt": true,
      "mcp_flag": "--mcp",
      "modes": {
        "yolo": [
          "--dangerously-bypass-approvals-and-sandbox",
          "--skip-git-repo-check",
          "-c",
          "model_reasoning_effort=\"medium\""
        ]
      }
    }
  }
}
